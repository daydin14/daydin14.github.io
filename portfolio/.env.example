# Optional. The site builds and runs with these left blank.
# Vite exposes VITE_* and, for the existing local file, REACT_APP_* (see vite.config.js).

# Google Analytics 4 measurement ID (G-XXXXXXXX)
VITE_GOOGLE_TAG_ID=

# Google Tag Manager container ID (GTM-XXXXXXX)
VITE_GOOGLE_TAG_MANAGER_ID=

# EmailJS. Leave these blank until the real values are available.
# The contact form sends these template variables:
# from_name, reply_to, message, subject
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
